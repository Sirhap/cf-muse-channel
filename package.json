{
  "name": "cf-muse-channel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types --env-file .dev.vars.example",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "test:python": "python3 -m unittest discover -s tests -p \"test_*.py\""
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.18.0",
    "typescript": "5.9.3",
    "vitest": "4.1.0",
    "wrangler": "4.107.0"
  },
  "engines": {
    "node": ">=22"
  }
}
