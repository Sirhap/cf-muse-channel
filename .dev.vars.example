# Copy to .dev.vars; provide a random key with at least 32 characters.
DEMO_KEY=""
# A Cookie request header, not an entire exported cookie file.
MUSE_COOKIE=""
# Long Cookie headers can use two Secrets instead of MUSE_COOKIE.
MUSE_COOKIE_PART_1=""
MUSE_COOKIE_PART_2=""
# Optional: leave empty to let Muse discover the VM from the Cookie.
MUSE_VM_ID=""

AUTO_APPROVAL_ENABLED="false"
AUTO_APPROVAL_EVENTS_ENABLED="false"
AUTO_APPROVAL_POLICY_JSON=""

# Optional: a separate management password (12–512 characters) to enable /admin.
MUSE_ADMIN_KEY=""

MANAGED_CHANNELS_ENABLED="false"
