{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cf-muse-cookie",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CREDENTIALS",
        "class_name": "MuseCredentials"
      },
      {
        "name": "MOBILE",
        "class_name": "ManagedChannels"
      }
    ]
  },
  "migrations": [
    {
      "tag": "cookie-v1",
      "new_sqlite_classes": [
        "MuseCredentials"
      ]
    },
    {
      "tag": "managed-v1",
      "new_sqlite_classes": [
        "ManagedChannels"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "54 20 * * *"
    ]
  },
  "vars": {
    "AUTO_APPROVAL_ENABLED": "false",
    "AUTO_APPROVAL_POLICY_JSON": "{\"rules\":[]}",
    "MANAGED_CHANNELS_ENABLED": "false"
  }
}
