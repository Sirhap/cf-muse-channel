{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cf-muse-cookie",
  "account_id": "REPLACE_WITH_YOUR_ACCOUNT_ID",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "muse.example.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CREDENTIALS",
        "class_name": "MuseCredentials"
      }
    ]
  },
  "migrations": [
    {
      "tag": "cookie-v1",
      "new_sqlite_classes": [
        "MuseCredentials"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "54 20 * * *"
    ]
  }
}
